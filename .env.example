# Copy to .env and fill in. .env is gitignored — never commit it.
# SiteGround accepts publickey auth only; there is no password fallback.

SG_HOST=ssh.eve-n.nl
SG_PORT=18765
SG_USER=u2072-mbcxascz03lu

# Private key registered in SiteGround Site Tools > Devs > SSH Keys Manager.
# The path must not contain spaces — rsync -e cannot quote it.
SG_KEY=~/.ssh/eve-n_deploy_ed25519

# Absolute remote paths to the themes directories. Both must end in
# /wp-content/themes; bin/deploy.sh derives the WordPress root by stripping it.
# Confirm with:
#   ssh -p $SG_PORT $SG_USER@$SG_HOST 'ls -d ~/www/*/public_html/wp-content/themes'
#
# Confirmed 2026-08-07:
#   SG_THEMES_PATH=/home/u2072-mbcxascz03lu/www/eve-n.nl/public_html/wp-content/themes
#   SG_STAGING_THEMES_PATH=/home/u2072-mbcxascz03lu/www/staging2.eve-n.nl/public_html/wp-content/themes
SG_THEMES_PATH=
SG_STAGING_THEMES_PATH=
